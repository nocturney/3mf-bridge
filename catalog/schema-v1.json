{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nocturney/3mf-bridge/blob/feature/printer-catalog/catalog/schema-v1.json",
  "title": "SliceBridge printer registry maker snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manufacturer",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "ref_file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "chain_file": {
      "type": "object",
      "required": [
        "name",
        "path",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "chosen_profile": {
      "type": "object",
      "required": [
        "provider",
        "publisher",
        "manifest",
        "nozzles_mm"
      ],
      "properties": {
        "provider": {
          "enum": [
            "manufacturer",
            "orca",
            "prusa"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "nozzles_mm": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": [
        "nozzle_mm",
        "machine",
        "process",
        "filament"
      ],
      "properties": {
        "nozzle_mm": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "$ref": "#/$defs/ref_file"
        },
        "process": {
          "allOf": [
            {
              "$ref": "#/$defs/ref_file"
            },
            {
              "type": "object",
              "required": [
                "inheritance"
              ],
              "properties": {
                "inheritance": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/chain_file"
                  }
                }
              }
            }
          ]
        },
        "filament": {
          "allOf": [
            {
              "$ref": "#/$defs/ref_file"
            },
            {
              "type": "object",
              "required": [
                "inheritance"
              ],
              "properties": {
                "inheritance": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/chain_file"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "publisher",
        "repository",
        "commit",
        "bundle_version",
        "manifest",
        "model",
        "nozzles_mm",
        "variants",
        "validation",
        "warnings"
      ],
      "properties": {
        "provider": {
          "enum": [
            "manufacturer",
            "orca",
            "prusa"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "bundle_version": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ref_file"
        },
        "model": {
          "$ref": "#/$defs/ref_file"
        },
        "nozzles_mm": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "validation": {
          "enum": [
            "structural_verified",
            "index_only"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_printer_sections": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "manufacturer",
        "model",
        "release_date",
        "release_date_evidence",
        "conversion_tested",
        "profile_sources",
        "preferred_profile",
        "preferred_by_nozzle",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "release_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "release_date_evidence": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "conversion_tested": {
          "const": false
        },
        "status": {
          "enum": [
            "index_only",
            "structural_verified"
          ]
        },
        "preferred_profile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/chosen_profile"
            }
          ]
        },
        "preferred_by_nozzle": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "additionalProperties": {
            "type": "object",
            "required": ["provider", "publisher", "manifest", "machine", "process", "filament"],
            "properties": {
              "provider": {"enum": ["manufacturer", "orca", "prusa"]},
              "publisher": {"type": "string", "minLength": 1},
              "manifest": {"type": "string", "minLength": 1},
              "machine": {"type": "string", "minLength": 1},
              "process": {"type": "string", "minLength": 1},
              "filament": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "profile_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
